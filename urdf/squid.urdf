<?xml version="1.0"?>

<robot name="three_arm_octobot">
  <!-- ==================================================
       ROOT BASE LINK (UNFIXED)
       ================================================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <!-- ==================================================
       500 mm TRIANGULAR BIPYRAMID HEAD
       ================================================== -->
  <link name="head">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://octopus_description/meshes/head.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="head_blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://octopus_description/meshes/head.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="head">
    <material>Gazebo/Blue</material>
  </gazebo>
  <joint name="base_to_head" type="fixed">
    <parent link="base_link"/>
    <child link="head"/>
    <origin xyz="0 0 0.5" rpy="3.14159265 0 0"/>
  </joint>
  <!-- ==================================================
       IMU SENSOR LINK
       ================================================== -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="imu_red">
        <color rgba="0.8 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="imu_link">
    <material>Gazebo/Red</material>
  </gazebo>
  <joint name="head_to_imu" type="fixed">
    <parent link="head"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  
  <!-- ==================================================
       ARM1 MOUNT - OFFSET BY 25.0mm
       ================================================== -->
  <link name="arm1_mount">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="arm1_mount_joint" type="fixed">
    <parent link="head"/>
    <child link="arm1_mount"/>
    <origin xyz="0.05824858 0.10088951 0.08129681" rpy="0.00000000 0.94566257 1.04719755"/>
  </joint>
  <link name="arm1_segment_0">
